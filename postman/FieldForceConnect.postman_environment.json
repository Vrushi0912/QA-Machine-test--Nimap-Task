{
  "id": "ffc-env-001",
  "name": "FieldForceConnect - Test",
  "values": [
    {
      "key": "baseUrl",
      "value": "https://test.fieldforceconnect.com",
      "type": "default",
      "enabled": true
    },
    {
      "key": "apiBasePath",
      "value": "/api",
      "type": "default",
      "enabled": true,
      "description": "Update once you've identified the real API prefix via browser DevTools Network tab (e.g. /api/v1)"
