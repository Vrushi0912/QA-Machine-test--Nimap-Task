      "enabled": true
    },
    {
      "key": "invalidPassword",
      "value": "WrongPass@999",
      "type": "default",
      "enabled": true
    },
    {
      "key": "authToken",
      "value": "",
      "type": "secret",
      "enabled": true,
      "description": "Auto-populated by the test script in the Login request after a successful call"
    },
    {
      "key": "customerName",
      "value": "Postman Test Customer",
      "type": "default",
      "enabled": true
    },
    {
      "key": "customerEmail",
      "value": "postman.customer@test.com",
      "type": "default",
      "enabled": true
    },
    {
      "key": "customerPhone",
      "value": "9876543210",
      "type": "default",
      "enabled": true
    }
  ],
  "_postman_variable_scope": "environment"
